<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Only shown while the list is in Delete mode; the row itself handles the tap so the
         whole row (not just the box) can be used to tick an entry. -->
    <CheckBox
        android:id="@+id/row_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/fab_margin"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/date_display"
        android:layout_width="0dp"
        android:layout_height="@dimen/gas_entry_height"
        android:layout_weight="1"
        android:textSize="@dimen/font_entry_size"
        android:gravity="center"/>

    <TextView
        android:id="@+id/gallons_display"
        android:layout_width="0dp"
        android:layout_height="@dimen/gas_entry_height"
        android:layout_weight="1"
        android:textSize="@dimen/font_entry_size"
        android:gravity="center" />

    <TextView
        android:id="@+id/odometer_display"
        android:layout_width="0dp"
        android:layout_height="@dimen/gas_entry_height"
        android:layout_weight="1"
        android:textSize="@dimen/font_entry_size"
        android:gravity="center"/>

    <TextView
        android:id="@+id/average_mileage_display"
        android:layout_width="0dp"
        android:layout_height="@dimen/gas_entry_height"
        android:layout_weight="1"
        android:textSize="@dimen/font_entry_size"
        android:gravity="center"/>

</LinearLayout>